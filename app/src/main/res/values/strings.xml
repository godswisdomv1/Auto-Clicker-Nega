  <!-- Onboarding -->
  <string name="onboarding_welcome_title">Tap, swipe and wait on autopilot</string>
  <string name="onboarding_welcome_body">Nega taps and swipes for you, and can watch the screen and act when it sees an image, text or colour you chose. It works over any app and needs no root.</string>
  <string name="action_continue">Continue</string>
  <string name="disclosure_title">Before you turn this on</string>
  <string name="disclosure_body">Auto Clicker Nega uses Android\'s accessibility service for two things you ask for: tapping and swiping on the screen, and capturing the screen so it can find the image, text or colour you chose.\n\nCaptured pictures are used on this phone only. They are never saved or sent anywhere. The service does not read the contents of other apps, and nothing leaves your device.\n\nYou can turn the service off at any time in Android\'s accessibility settings.</string>
  <string name="disclosure_agree">Agree and continue</string>
  <string name="disclosure_decline">Not now</string>
  <string name="onboarding_enable_title">Turn on the service</string>
  <string name="onboarding_enable_body">In Android\'s accessibility settings, find Auto Clicker Nega and switch it on. Then come back here.</string>
  <string name="onboarding_later">I\'ll do this later</string>
  <string name="onboarding_ready_title">You\'re all set</string>
  <string name="onboarding_ready_body">The service is running. Open the floating panel from Home to place your first tap.</string>
  <string name="onboarding_go_home">Go to Home</string>

